# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co

# Current API key format. Dashboard: Project Settings -> API Keys.
#   publishable — replaces the old anon key. Safe in a browser, relies on RLS.
#   secret      — replaces service_role. Bypasses RLS. Server-side only, never
#                 in a client bundle, never in a repo.
# Neither is a JWT, and neither is used to verify tokens.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Legacy names for the same two keys. Set these only if you are on an older
# project that still issues anon / service_role JWTs.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth — JWT verification
#
# Normally nothing to set here.
#
# Supabase signs access tokens with an ASYMMETRIC key (ES256 over P-256) and
# publishes the public half at
#   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# The backend fetches that automatically and verifies signatures it has no
# ability to produce. No secret is involved, which is the point — there is
# nothing here that could forge a token if it leaked.

# Legacy HS256 shared secret. Dashboard: Project Settings -> JWT Keys ->
# Legacy JWT Secret. Needed ONLY while a project is mid-rotation and sessions
# signed by a previous shared secret are still unexpired; Supabase keeps a
# rotated-out key valid until its tokens die.
#
# Blank means "reject HS256 tokens", which is correct once those have aged out.
# It is NOT the publishable key and NOT the secret key.
SUPABASE_JWT_SECRET=

# Points the verifier at a different JWKS endpoint. Tests only — they serve a
# local key set so they can mint tokens the verifier will accept. Leave blank
# in every real environment; blank derives the URL from SUPABASE_URL above.
SUPABASE_JWT_JWKS_URL_OVERRIDE=

# Audience claim Supabase stamps on access tokens. Only change this for a
# different identity provider; blank disables audience checking entirely.
SUPABASE_JWT_AUDIENCE=authenticated

# Database Configuration (Supabase PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
