# Secrets. `.env` alone matches only that exact name and `*.env` only matches
# names *ending* in .env, so neither covered `.env.bak-direct-host` — a backup
# holding the same live database password under a different suffix. Ignore the
# whole family by prefix and re-admit the one file that is meant to be shared.
.env
.env.*
*.env
*.env.local
!.env.example
__pycache__/
venv/
.venv/
env/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Load-test artefacts. load-context.json holds live Supabase access tokens and
# the throwaway passwords behind them, so it is ignored for the same reason .env
# is; the results directory is regenerated by every run.
tests/load/load-context.json
tests/load/results/
