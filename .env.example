# Environment variable names only — DO NOT put real secrets here.
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

# === Application ===
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# === Backend ===
API_BASE_URL=http://localhost:8000

# === Database ===
DATABASE_URL=postgresql+asyncpg://sahayak:changeme@localhost:5432/sahayak_db

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Auth (Supabase or custom JWT) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# === Google Maps ===
# Use a server-restricted key for backend calls
GOOGLE_MAPS_SERVER_KEY=
# Use an HTTP-referrer-restricted key for frontend (set in frontend/.env)
GOOGLE_MAPS_BROWSER_KEY=

# === Storage (Supabase Storage or S3-compatible) ===
STORAGE_BUCKET=sahayak-uploads
STORAGE_REGION=ap-south-1

# === Notifications ===
# Set to 'stub' for local development — no real SMS/push sent
NOTIFICATION_MODE=stub
# SMS_PROVIDER_KEY=
# PUSH_PROVIDER_KEY=

# === Dispatch Configuration ===
R_SEARCH_M=7000
MAX_CONCURRENT_JOBS=2
MAX_LOCATION_AGE_S=120
EXPERIENCE_TARGET=10
OFFER_TIMEOUT_S=45
MAX_OFFER_ATTEMPTS=5
WEIGHT_DISTANCE=0.45
WEIGHT_LOAD=0.20
WEIGHT_SKILL=0.20
WEIGHT_RATING=0.15
