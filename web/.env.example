# ── Sahayak frontend runtime configuration ──────────────────────────────────
# Copy this file to `.env` and adjust. Vite only exposes vars prefixed VITE_.

# Base URL every service module prefixes its paths with. The dev server proxies
# /api to http://localhost:8000 (see vite.config.ts), so the default works
# against a locally running backend without any change here.
VITE_API_BASE_URL=/api/v1

# Seeded identities and placeholder data — the navbar role switcher, demo
# profiles. Defaults to on under `vite dev` and off in a production build.
VITE_DEMO_MODE=true

# Partner dispatch API switch.
#
# The majority of partner endpoints are now live (as of 2026-10-06):
#   GET   /partners/me/offers                   → getPendingOffer()
#   POST  /job-assignments/{id}/respond         → acceptOffer() / rejectOffer()
#   PATCH /partners/{partner_id}/availability  → setAvailability()
#   POST  /partners/{partner_id}/location      → reportLocation()
#   GET   /partners/me/jobs/active              → getActiveJob()
#   GET   /partners/me/stats                    → getTrustStats()
#
# Default is now false — real API calls are made for the six endpoints above.
#
# Set to true ONLY if you need to demo the earnings UI, which still
# has no backend endpoint and whose mock is the only working data path:
#   getEarnings()   — no /partners/me/earnings endpoint (no payments data yet)
#
# Note: getEarnings() always uses the mock regardless
# of this flag — see partner.service.ts for per-function rationale.
VITE_PARTNER_API_MOCK=false
