# ── Sahayak frontend runtime configuration ──────────────────────────────────
# Copy this file to `.env` and adjust. Vite only exposes vars prefixed VITE_.

# Base URL every service module prefixes its paths with. The dev server proxies
# /api to http://localhost:8000 (see vite.config.ts), so the default works
# against a locally running backend without any change here.
VITE_API_BASE_URL=/api/v1

# ── Supabase Auth — REQUIRED for sign-in to work at all ─────────────────────
#
# The backend verifies Supabase access tokens against this project's JWKS and
# never issues tokens of its own, so a phone OTP against Supabase is the only
# way this app can obtain a bearer. Without these two values the login screen
# says so instead of pretending to sign anyone in.
#
# Both come from backend/.env (SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY).
#
# The PUBLISHABLE key is the right one here: it identifies the project to the
# public auth endpoints, is designed to ship inside a browser bundle, and grants
# nothing by itself. Never put SUPABASE_SECRET_KEY or a service-role key in this
# file — anything prefixed `sb_secret_` in a VITE_ var is published to every
# visitor.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Seeded identities and placeholder data — the navbar role switcher, demo
# profiles. Defaults to on under `vite dev` and off in a production build.
#
# Note what this no longer does: it used to make RequestHelpPage substitute the
# string 'demo-token-owner-asha' for a real bearer when nobody was signed in.
# The backend rejects that on sight, so the "demo" path was a 401. Demo mode now
# only affects placeholder *data*, never credentials.
VITE_DEMO_MODE=true

# Partner dispatch API switch.
#
# The majority of partner endpoints are now live (as of 2026-10-06):
#   GET   /partners/me/offers                   → getPendingOffer()
#   POST  /job-assignments/{id}/respond         → acceptOffer() / rejectOffer()
#   PATCH /partners/{partner_id}/availability  → setAvailability()
#   POST  /partners/{partner_id}/location      → reportLocation()
#   GET   /partners/me/jobs/active              → getActiveJob()
#   GET   /partners/me/stats                    → getTrustStats()
#
# Default is now false — real API calls are made for the six endpoints above.
# That only works once the two VITE_SUPABASE_* values above are set: every one
# of these routes requires a partner token.
#
# Set to true ONLY if you need to demo the earnings UI, which still
# has no backend endpoint and whose mock is the only working data path:
#   getEarnings()   — no /partners/me/earnings endpoint (no payments data yet)
#
# Note: getEarnings() always uses the mock regardless
# of this flag — see partner.service.ts for per-function rationale.
VITE_PARTNER_API_MOCK=false
