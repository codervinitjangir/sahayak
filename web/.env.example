# ── Sahayak frontend runtime configuration ──────────────────────────────────
# Copy this file to `.env` and adjust. Vite only exposes vars prefixed VITE_.

# Base URL every service module prefixes its paths with. The dev server proxies
# /api to http://localhost:8000 (see vite.config.ts), so the default works
# against a locally running backend without any change here.
VITE_API_BASE_URL=/api/v1

# Seeded identities and placeholder data — the navbar role switcher, demo
# profiles. Defaults to on under `vite dev` and off in a production build.
VITE_DEMO_MODE=true

# Partner dispatch API switch.
#
# While true, src/services/partner.service.ts answers every /partners/me/*
# call from the in-memory fixture in src/services/partner.mock.ts, so the
# partner console (dashboard, offers, active job) is fully usable with no
# backend at all. The real fetch calls are already written alongside each mock
# branch — flip this to false once the endpoints ship and nothing else needs to
# change.
VITE_PARTNER_API_MOCK=true
